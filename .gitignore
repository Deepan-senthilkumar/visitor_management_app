# Windows OS junk
Thumbs.db
ehthumbs.db
desktop.ini

# IntelliJ / Android Studio / IDE related
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter & Dart Caches & Dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Android Specific
.gradle/
.kotlin/
local.properties
**/android/**/build/
**/android/.gradle/
**/android/.kotlin/
**/android/local.properties
/android/app/debug
/android/app/profile
/android/app/release
captures/
*.apk
*.aab

# iOS & macOS Specific
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile/
**/ios/**/DerivedData/
*.ipa

# Windows & Linux Native Desktop Temporary Files
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Local Generated Documents & Scratch Outputs
guide.html
*.pdf
